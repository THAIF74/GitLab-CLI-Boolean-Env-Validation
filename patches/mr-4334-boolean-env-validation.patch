+// clearBooleanEnvVars keeps the validation tests independent of the host environment.
+func clearBooleanEnvVars(t *testing.T) {
+	t.Helper()
+
+	for _, kd := range KeySchema {
+		if kd.Type != TypeBool {
+			continue
+		}
+		for _, name := range EnvVarsForKey(kd) {
+			t.Setenv(name, "")
+		}
+	}
+	for _, ev := range nonSchemaEnvVars {
+		if ev.Type == TypeBool {
+			t.Setenv(ev.Name, "")
+		}
+	}
+}
+
+func TestValidateBoolEnvVars(t *testing.T) {
+	t.Run("valid schema and non-schema values", func(t *testing.T) {
+		clearBooleanEnvVars(t)
+		t.Setenv("GLAB_CHECK_UPDATE", "false")
+		t.Setenv("FORCE_HYPERLINKS", "1")
+
+		assert.NoError(t, ValidateBoolEnvVars())
+	})
+
+	t.Run("unset values are ignored", func(t *testing.T) {
+		clearBooleanEnvVars(t)
+		assert.NoError(t, os.Unsetenv("GLAB_CHECK_UPDATE"))
+
+		assert.NoError(t, ValidateBoolEnvVars())
+	})
+
+	t.Run("empty values are ignored", func(t *testing.T) {
+		clearBooleanEnvVars(t)
+		t.Setenv("GLAB_CHECK_UPDATE", "")
+
+		assert.NoError(t, ValidateBoolEnvVars())
+	})
+
+	t.Run("invalid schema value is reported", func(t *testing.T) {
+		clearBooleanEnvVars(t)
+		t.Setenv("GLAB_CHECK_UPDATE", "maybe")
+
+		err := ValidateBoolEnvVars()
+		assert.ErrorContains(t, err, "GLAB_CHECK_UPDATE=\"maybe\"")
+	})
+
+	t.Run("invalid non-schema value is reported", func(t *testing.T) {
+		clearBooleanEnvVars(t)
+		t.Setenv("FORCE_HYPERLINKS", "sure")
+
+		err := ValidateBoolEnvVars()
+		assert.ErrorContains(t, err, "FORCE_HYPERLINKS=\"sure\"")
+	})
+
+	t.Run("all invalid values are reported together", func(t *testing.T) {
+		clearBooleanEnvVars(t)
+		t.Setenv("GLAB_CHECK_UPDATE", "maybe")
+		t.Setenv("FORCE_HYPERLINKS", "sure")
+
+		err := ValidateBoolEnvVars()
+		assert.ErrorContains(t, err, "FORCE_HYPERLINKS=\"sure\"")
+		assert.ErrorContains(t, err, "GLAB_CHECK_UPDATE=\"maybe\"")
+	})
