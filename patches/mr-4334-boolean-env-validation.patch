+// ValidateBoolEnvVars rejects invalid values for every boolean environment variable. It
+// checks schema-backed variables and the variables listed separately in nonSchemaEnvVars.
+func ValidateBoolEnvVars() error {
+	var names []string
+	seen := make(map[string]struct{})
+	add := func(name string) {
+		if _, ok := seen[name]; ok {
+			return
+		}
+		seen[name] = struct{}{}
+		names = append(names, name)
+	}
+
+	for _, kd := range KeySchema {
+		if kd.Type != TypeBool {
+			continue
+		}
+		for _, name := range EnvVarsForKey(kd) {
+			add(name)
+		}
+	}
+	for _, ev := range nonSchemaEnvVars {
+		if ev.Type == TypeBool {
+			add(ev.Name)
+		}
+	}
+
+	var invalid []string
+	for _, name := range names {
+		value, ok := os.LookupEnv(name)
+		if !ok || value == "" {
+			continue
+		}
+		if _, err := strconv.ParseBool(value); err != nil {
+			invalid = append(invalid, fmt.Sprintf("%s=%q", name, value))
+		}
+	}
+	if len(invalid) == 0 {
+		return nil
+	}
+
+	slices.Sort(invalid)
+	return fmt.Errorf("invalid boolean environment variable value(s): %s; use true, false, 1, 0, t, or f (case-insensitive)", strings.Join(invalid, ", "))
+}
+
 // EnvVars returns every environment variable glab reads, one entry per name so
 // that a reader searching for the name they already have set finds it. Entries
 // sort by the preferred name for the key, keeping alternatives directly beneath
